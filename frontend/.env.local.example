# FastAPI origin used by Next.js rewrites (server-side only).
BACKEND_URL=http://localhost:8000

# Leave unset so the browser calls same-origin /api and /static (recommended).
# Set this only when the frontend is hosted separately from the API.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Auth Platform → Clients → Web application → Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
